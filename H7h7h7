-- 💎 ORE FILTERS
-- ====================================================================
local function getOreRarity(id)
    if not id then return 1 end
    id = tostring(id):match("Ore_%d+") or tostring(id)
    if OreConfig then
        local cfg = OreConfig[id]
        if cfg and cfg.Rarity then return cfg.Rarity end
    end
    local n = tonumber(id:match("%d+"))
    if not n then return 1 end
    if n >= 48 then return 10 elseif n >= 40 then return 9
    elseif n >= 32 then return 8 elseif n >= 26 then return 7
    elseif n >= 20 then return 6 elseif n >= 15 then return 5
    elseif n >= 10 then return 4 elseif n >= 6 then return 3
    elseif n >= 3 then return 2 else return 1 end
end
local function isOreHighTier(id)
    return not Config.OnlyHighestOres or getOreRarity(id) >= (Config.MinOreRarity or 8)
end

