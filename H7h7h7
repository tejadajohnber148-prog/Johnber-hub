local function addLog(msg)
    table.insert(Runtime.Logs, 1, string.format("[Johnber Hub] %s — %s", os.date("%X"), msg))
    if #Runtime.Logs > 30 then table.remove(Runtime.Logs) end
end

local Suffixes = {
    {1e+33, "Dc"}, {1e+30, "No"}, {1e+27, "Oc"}, {1e+24, "Sp"},
    {1e+21, "Sx"}, {1e+18, "Qi"}, {1e+15, "Qa"}, {1e+12, "T"},
    {1e+9, "B"}, {1e+6, "M"}, {1e+3, "K"}
}
local function formatNumber(n)
    local num = tonumber(n)
    if not num then return tostring(n or "0") end
    for _, it in ipairs(Suffixes) do
        if num >= it[1] then return string.format("%.2f%s", num / it[1], it[2]) end
    end
    return tostring(math.floor(num))
end

