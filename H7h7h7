function Actions.ClaimAllOres()
    local oc = workspace:FindFirstChild("OreCache")
    local cnt = 0
    if oc then
        for _, ore in ipairs(oc:GetChildren()) do
            if isOreHighTier(ore.Name) then
                local prompt = ore:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt and fireproximityprompt then pcall(function() fireproximityprompt(prompt) end); cnt += 1 end
            end
        end
    end
    pcall(function() Remotes.ClaimedAllOre:FireServer() end)
    pcall(function() LeftInfoGUI.UpdateOrePack(0) end)
    Runtime.TotalOresClaimed += cnt
end

function Actions.StartStage(n)
    pcall(function() StageUtils.StartFight("Stage_"..n) end)
    addLog("Started Stage "..n)
end

function Actions.PacketClearAllStages()
    local total = 0
    local start = Config.OnlyHighestOres and (Config.MinOreRarity >= 8 and 21 or 18) or 1
    for i = start, 22 do
        local ok, res = pcall(function() return Remotes.StageFinished:InvokeServer("Stage_"..i) end)
        if ok and type(res) == "table" then
            for _, oreType in pairs(res) do
                if isOreHighTier(oreType) then
                    pcall(function() if Remotes.GetOre:InvokeServer(_) then total += 1 end end)
                end
            end
        end
        pcall(function() Remotes.ClaimedAllOre:FireServer() end)
    end
    if Config.AutoSellBag then pcall(function() BackpackData.SellAll() end) end
    addLog("⚡ Cleared stages "..start.."-22: +"..total.." ores")
end

-- Tower Function
function Actions.PacketClearTower(startRound)
    startRound = startRound or Config.TowerStartRound or 1
    local tickets = 0
    if BackpackData and BackpackData.GetItemDataByIDType then
        local item = BackpackData.GetItemDataByIDType("Dungeon_Ticket", "Material")
        tickets = item and item.Number or 0
    end
    if tickets <= 0 then
        addLog("❌ No dungeon tickets! Stopped tower.")
        return 0
    end

    local runs = 0
    while tickets > 0 and Runtime.Running do
        tickets -= 1; runs += 1
        addLog("🏰 Tower run #"..runs.." starting round "..startRound)

        local ok, err = pcall(function()
            local dungeon = Remotes.TryIntoDungeonRF:InvokeServer("Tower")
            if not dungeon then error("Failed enter") end

            for r = startRound, 999 do
                Remotes.StartRoundRE:FireServer(r)
                task.wait(0.4)
                local done = Remotes.CompleteRoundRF:InvokeServer(r, true)
                if not done then break end
                Runtime.TotalTowerRounds += 1
                if r % 5 == 0 then task.wait(0.75) end
            end
            Remotes.ExitDungeonRE:FireServer()
        end)

        if not ok then
            addLog("⚠️ Tower error: "..tostring(err))
            task.wait(1)
        end
        Runtime.TotalTowerRuns += 1
        task.wait(1)
    end
    addLog("✅ Tower done — "..runs.." runs")
    return runs
end

