function Actions.StopTrain()
    pcall(function()
        if TrainCTRL.ExitAutoTrain then TrainCTRL.ExitAutoTrain() end
        if TrainCTRL.EndTrain then TrainCTRL.EndTrain() end
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            for _, t in ipairs(hum:GetPlayingAnimationTracks()) do
                if t.Name:lower():find("train") then t:Stop() end
            end
        end
    end)
    addLog("Stopped Auto Train.")
end

function Actions.StopStage()
    Config.AutoStageLoop = false
    Config.AutoAttackMobs = false
    pcall(function() if Remotes.ExitFightBE then Remotes.ExitFightBE:Fire(true) end end)
    pcall(function() if TranslateUtils and TranslateUtils.ToSpawn then TranslateUtils.ToSpawn(LocalPlayer.Character) end end)
    LocalPlayer:SetAttribute("IntoFight", nil)
    addLog(string.format("🛑 Stopped Stage %d", Config.SelectedStage))
end

