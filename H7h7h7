_G.JohnberHubCleanup = function()
    Runtime.Running = false
    for _, c in pairs(Runtime.Connections) do pcall(function() c:Disconnect() end) end
    for _, t in pairs(Runtime.Threads) do pcall(function() task.cancel(t) end) end
    if _G.Johnber_OriginalDamageOnce then HPCTRL.DamageOnce = _G.Johnber_OriginalDamageOnce end
    if _G.Johnber_OriginalCCPlrDamage then CalculateUtils.CCPlrDamage = _G.Johnber_OriginalCCPlrDamage end
    if _G.Johnber_OriginalTryFireDamageEvent then DamageUtils.TryFireDamageEvent = _G.Johnber_OriginalTryFireDamageEvent end
    if _G.Johnber_OriginalShowMessage then Message.showMessage = _G.Johnber_OriginalShowMessage end
    if _G.Johnber_OriginalCameraShake then
        CameraUtils.PosShakeOnce = _G.Johnber_OriginalCameraShake.PosShakeOnce
        CameraUtils.DirShakeOnce = _G.Johnber_OriginalCameraShake.DirShakeOnce
        CameraUtils.NonShakeOnce = _G.Johnber_OriginalCameraShake.NonShakeOnce
        CameraUtils.MoveShake = _G.Johnber_OriginalCameraShake.MoveShake
    end
    _G.JohnberHubConfig = nil
    _G.JohnberHubActions = nil
    addLog("✅ Johnber Hub unloaded")
end

