    _G.Johnber_OriginalTryFireDamageEvent = DamageUtils.TryFireDamageEvent
    DamageUtils.TryFireDamageEvent = function(attacker, hitList, damageInfo)
        local isSelf = (attacker == LocalPlayer or attacker == LocalPlayer.Character)
        if isSelf then
            if Config.HitAllMobs and getStageEnemies then
                local stageMobs = getStageEnemies() or {}
                local seen = {}
                for _, v in ipairs(hitList or {}) do if v.UUID then seen[v.UUID] = true end end
                for _, e in ipairs(stageMobs) do
                    if not seen[e.uuid] then
                        table.insert(hitList, { Type = "Enemy", UUID = e.uuid, Model = e.model })
                    end
                end
            end
            if Config.OneHitKill and damageInfo then damageInfo.Damage = 1e35 end
        end
        return _G.Johnber_OriginalTryFireDamageEvent(attacker, hitList, damageInfo)
    end
end

