        if egg.Name == "Egg" and egg:IsA("BasePart") then
            local dist = (egg.Position - hrp.Position).magnitude
            if dist < shortestDist then
                shortestDist = dist
                nearestEgg = egg
            end
        end
    end

    if nearestEgg then
        hrp.CFrame = CFrame.new(nearestEgg.Position + Vector3.new(0, 5, 0))
    end
end

local function collectEggs()
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = player.Character.HumanoidRootPart
    for _, egg in pairs(workspace:GetChildren()) do
        if egg.Name == "Egg" and egg:IsA("BasePart") then
            hrp.CFrame = CFrame.new(egg.Position + Vector3.new(0, 5, 0))
            wait(0.3) -- Allow time to collect egg
        end
    end
end

local function createESPForEggs(enabled)
    for _, egg in pairs(workspace:GetChildren()) do
        if egg.Name == "Egg" and egg:IsA("BasePart") then
            local existing = egg:FindFirstChild("JohnberESP")
            if enabled then
                if not existing then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "JohnberESP"
                    highlight.FillColor = Color3.fromRGB(255, 255, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
                    highlight.Parent = egg
                end
            else
                if existing then
                    existing:Destroy()
                end
            end
        end
    end
end

