local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

local EggsFolder = workspace:WaitForChild("Eggs")
local Base = workspace:WaitForChild("Base")

local AutoSteal = false
local ShowBestEgg = true
local CurrentHighlight

--// CHARACTER
local function getCharacter()
    return Player.Character or Player.CharacterAdded:Wait()
end

local function getRoot()
    local Character = getCharacter()
    return Character:WaitForChild("HumanoidRootPart")
end

--// FIND BEST EGG
local function getBestEgg()
    local BestEgg = nil
    local BestValue = -math.huge

    for _, Egg in ipairs(EggsFolder:GetChildren()) do
        if Egg:IsA("Model") or Egg:IsA("BasePart") then
            local Value = Egg:GetAttribute("RarityValue") or 0

            if Value > BestValue then
                BestValue = Value
                BestEgg = Egg
            end
        end
    end

    return BestEgg
end

local function getEggPosition(Egg)
    if Egg:IsA("Model") then
        return Egg:GetPivot().Position
    elseif Egg:IsA("BasePart") then
        return Egg.Position
    end
end

--// HIGHLIGHT BEST EGG
local function updateHighlight()
    if CurrentHighlight then
        CurrentHighlight:Destroy()
        CurrentHighlight = nil
    end

    if not ShowBestEgg then
        return
    end

    local BestEgg = getBestEgg()

    if BestEgg then
        local Highlight = Instance.new("Highlight")
        Highlight.Name = "JohnberBestEgg"
        Highlight.Adornee = BestEgg
        Highlight.FillTransparency = 0.45
        Highlight.OutlineTransparency = 0
        Highlight.Parent = BestEgg

        CurrentHighlight = Highlight
    end
end

--// TELEPORT TO BEST EGG
local function teleportToEgg()
    local Egg = getBestEgg()

    if Egg then
        local Position = getEggPosition(Egg)

        if Position then
            getRoot().CFrame = CFrame.new(Position + Vector3.new(0, 4, 0))
        end
    end
end

--// RETURN TO BASE
local function returnToBase()
    local Root = getRoot()

    if Base:IsA("BasePart") then
        Root.CFrame = Base.CFrame + Vector3.new(0, 4, 0)
    end
end

